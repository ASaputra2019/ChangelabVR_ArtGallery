--- !u!114 &6966564528169596692
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4739240139992837053}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Artistic imagery provides a safe space to convey emotion and to evoke
    and\nexplore feelings.\n\nMy goal is to create art that brings to light important
    topics, such as women\u2019s issues, in order to help others heal, in the same
    way that art has helped me heal.\n\nI use a contrasting palette, with light subjects
    on top of dark atmospheres, and baroque inspired lighting to create my oil paintings.
    This pushes the emotions of the pieces further.\n\nWhen I am creating, I am thinking
    about collective feminine trauma and the importance of eliminating shame.\n\n\n\t          
