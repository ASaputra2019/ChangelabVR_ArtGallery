--- !u!114 &6584250275082076637
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8801297431185187269}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u201CIn a world of fast fashion and mass production, it can be difficult
    to find truly unique, well-made pieces that are versatile enough to style in
    new ways and have enough personality to make a statement with each wear.  \r\nI
    wanted to give you all something real and unattainable.   A piece that is extremely
    versatile.  Something that will last.  A piece of myself.\r\nEmbossed with my
    motto, The Future of Fashion is Humility, each piece can be customized and worn
    differently \u2013 a necklace becomes a body chain becomes a belt, and so forth.\r\nI
    was scouting locations for a shoot once and came across a motorcycle manufacturer,
    and was just in awe as the sun reflected off the raw materials lying all over
    the ground.  Something so raw, undone, and industrial, and the endless possibilities
    of creating.  Sustainability and doing more with less are majorly on my mind.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
